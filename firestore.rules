rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validEvent() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0
        && d.date is timestamp
        && d.published is bool;
    }

    function validProduct() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0
        && d.kind in ['print', 'digital']
        && d.price is number && d.price > 0;
    }

    // Eventos: el publico solo lee los publicados (las consultas deben filtrar por published == true).
    match /events/{eventId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() && validEvent();
      allow delete: if isAdmin();

      // Fotos (metadatos): visibles de eventos publicados.
      match /photos/{photoId} {
        allow read: if isAdmin()
          || (resource.data.visible == true
              && get(/databases/$(database)/documents/events/$(eventId)).data.published == true);
        allow write: if isAdmin();
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct();
      allow delete: if isAdmin();
    }

    match /settings/store {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos: solo se escriben via Cloud Functions (Admin SDK ignora estas reglas).
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Todo lo demas (incluidas las antiguas users / purchases / photos raiz): denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
