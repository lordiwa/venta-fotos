# Copia a functions/.env (produccion) o functions/.env.local (emulador). Sin secretos: los de PayPal van en Secret Manager.

# Pagos en linea con PayPal. Ausente o distinto de "true": createOrder/captureOrder NO se exportan
# y el deploy no pide los secretos PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET. En el emulador local poner true.
PAYPAL_ENABLED=

# Solo si PAYPAL_ENABLED=true. Sandbox por defecto; en produccion: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Dias de vigencia del enlace de descarga (1..7).
DOWNLOAD_TTL_DAYS=7
